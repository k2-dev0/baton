#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
project_dir=$(dirname -- "$script_dir")
proxy_path="$project_dir/src/proxy.mjs"
launcher_path=${CODEX_AUTO_CODEX_BIN:-}

if [ -z "$launcher_path" ]; then
  launcher_path=$(command -v codex || true)
fi

usage() {
  printf '%s\n' "Usage: codex-auto app [WORKSPACE]" "       codex-auto check"
}

if [ -z "$launcher_path" ]; then
  printf '%s\n' "codex-auto: codex command was not found" >&2
  exit 69
fi

command_name=${1:-}
case "$command_name" in
  check)
    if [ "$#" -ne 1 ]; then
      usage >&2
      exit 64
    fi
    exec "$proxy_path" --router-check
    ;;
  app)
    if [ "$#" -gt 2 ]; then
      usage >&2
      exit 64
    fi
    workspace=${2:-.}
    if [ ! -d "$workspace" ]; then
      printf '%s\n' "codex-auto: workspace is not a directory: $workspace" >&2
      exit 66
    fi
    workspace=$(CDPATH= cd -- "$workspace" && pwd -P)
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac

set +e
pgrep -x ChatGPT >/dev/null 2>&1
desktop_status=$?
set -e

case "$desktop_status" in
  0)
    set +e
    pgrep -f "$proxy_path.*app-server" >/dev/null 2>&1
    router_status=$?
    set -e
    case "$router_status" in
      0) exec "$launcher_path" app "$workspace" ;;
      1)
        printf '%s\n' \
          "codex-auto: ChatGPT Desktop is already running without the model router." \
          "Running tasks were not interrupted. Quit Desktop manually, then run this command again." >&2
        exit 73
        ;;
      *)
        printf '%s\n' "codex-auto: cannot inspect Desktop process state; Desktop was not started" >&2
        exit 69
        ;;
    esac
    ;;
  1) ;;
  *)
    printf '%s\n' "codex-auto: cannot inspect Desktop process state; Desktop was not started" >&2
    exit 69
    ;;
esac

if ! "$proxy_path" --router-check >/dev/null; then
  printf '%s\n' "codex-auto: router compatibility check failed; Desktop was not started" >&2
  exit 78
fi

CODEX_CLI_PATH=$proxy_path
export CODEX_CLI_PATH
exec "$launcher_path" app "$workspace"
